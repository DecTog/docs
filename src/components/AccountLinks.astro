---
// Sign-in and sign-up on the hosted service, as in the dectog.com header.
// `stacked` renders both as full-width buttons for the menu below 800px.
interface Props {
	stacked?: boolean;
}

const { stacked = false } = Astro.props;
---

<a class:list={['login', { stacked }]} href="https://app.dectog.com/login">Log in</a>
<a class:list={['cta', { stacked }]} href="https://app.dectog.com/login?tab=signup">Get started</a>

<style>
	a {
		text-decoration: none;
		white-space: nowrap;
		transition:
			background-color var(--dt-ease),
			color var(--dt-ease);
	}
	.login {
		color: var(--dt-secondary);
		font-size: var(--sl-text-sm);
	}
	.login:hover {
		color: var(--dt-ink);
	}
	/* The one tangerine fill on the page. */
	.cta {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		height: 2.5rem;
		border-radius: var(--dt-radius-pill);
		padding-inline: 1.5rem;
		background-color: var(--dt-accent);
		color: #ffffff;
		font-family: var(--dt-font-display);
		font-size: var(--sl-text-sm);
		font-weight: 500;
		letter-spacing: 0.06em;
		text-transform: uppercase;
	}
	.cta:hover {
		background-color: color-mix(in srgb, var(--dt-accent) 90%, transparent);
	}

	.stacked {
		display: flex;
		align-items: center;
		justify-content: center;
		height: 2.75rem;
		border-radius: var(--dt-radius-pill);
	}
	.login.stacked {
		border: 1px solid var(--dt-hairline);
		color: var(--dt-ink);
		font-family: var(--dt-font-display);
		font-size: 0.9375rem;
		font-weight: 500;
	}
</style>
