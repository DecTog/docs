---
// Sign-in and sign-up on the hosted service, as in the dectog.com header.
// `stacked` renders both as full-width buttons for the menu below 800px.
interface Props {
	stacked?: boolean;
}

const { stacked = false } = Astro.props;
---

<a class:list={['login', { stacked }]} href="https://app.dectog.com/login">Log in</a>
<a class:list={['cta', { stacked }]} href="https://app.dectog.com/login?tab=signup">
	Get started
	<svg
		viewBox="0 0 24 24"
		width="16"
		height="16"
		fill="none"
		stroke="currentColor"
		stroke-width="2"
		stroke-linecap="round"
		stroke-linejoin="round"
		aria-hidden="true"
	>
		<path d="M7 7h10v10" />
		<path d="M7 17 17 7" />
	</svg>
</a>

<style>
	a {
		text-decoration: none;
		white-space: nowrap;
		transition:
			background-color var(--dt-ease),
			color var(--dt-ease);
	}
	.login {
		color: var(--dt-secondary);
		font-size: var(--sl-text-sm);
	}
	.login:hover {
		color: var(--dt-ink);
	}
	/* The page's main action: dectog.com's Ink pill, which turns white on the dark page. */
	.cta {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		gap: 0.375rem;
		height: 2.5rem;
		border-radius: var(--dt-radius-pill);
		padding-inline: 1.25rem 1rem;
		background-color: var(--dt-ink);
		color: var(--dt-page);
		font-family: var(--dt-font-display);
		font-size: 0.9375rem;
		font-weight: 500;
	}
	.cta:hover {
		background-color: color-mix(in srgb, var(--dt-ink) 88%, var(--dt-page));
	}

	.stacked {
		display: flex;
		align-items: center;
		justify-content: center;
		height: 2.75rem;
		border-radius: var(--dt-radius-pill);
	}
	.login.stacked {
		border: 1px solid var(--dt-hairline);
		color: var(--dt-ink);
		font-family: var(--dt-font-display);
		font-size: 0.9375rem;
		font-weight: 500;
	}
</style>
