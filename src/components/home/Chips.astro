---
// A row of shortcut links under the home page hero. The slot takes a Markdown list of links.
interface Props {
	label: string;
}

const { label } = Astro.props;
---

<nav class="chips not-content" aria-label={label}>
	<span class="label" aria-hidden="true">{label}</span>
	<slot />
</nav>

<style>
	.chips {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: center;
		gap: 0.75rem;
		margin-top: 2rem;
	}
	.label {
		font-size: var(--sl-text-xs);
		color: var(--dt-meta);
	}
	.chips :global(ul) {
		display: contents;
		list-style: none;
	}
	.chips :global(a) {
		display: inline-flex;
		align-items: center;
		height: 2rem;
		border-radius: var(--dt-radius-pill);
		padding-inline: 1rem;
		background-color: var(--dt-surface);
		color: var(--dt-ink);
		font-size: var(--sl-text-sm);
		text-decoration: none;
		transition: background-color var(--dt-ease);
	}
	.chips :global(a:hover) {
		background-color: var(--dt-surface-strong);
	}
</style>
