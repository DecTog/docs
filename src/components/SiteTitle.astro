---
// The dectog.com logo leads to the marketing site; the "Docs" pill beside it is the way back to
// the docs home. The logo is inline so its ink follows the theme (currentColor); the dot stays orange.
const { siteTitleHref } = Astro.locals.starlightRoute;
---

<div class="site-title">
	<a class="logo" href="https://dectog.com" aria-label="DecTog">
		<svg viewBox="38 25 649.8 205" height="38" aria-hidden="true">
			<path fill="currentColor" d="M38 217 V25 H122 A96 96 0 0 1 122 217 H114 V187 H122 A63 66 0 0 0 122 55 H70 V217 Z"></path>
			<path fill="#ff520a" d="M142 202 A28 28 0 1 1 86 202 A28 28 0 1 1 142 202 Z"></path>
			<path fill="currentColor" transform="translate(266 57.16) scale(0.57)" d="M0 196 V28 H52 A84 84 0 0 1 52 196 Z M24 50 V174 H52 A59 62 0 0 0 52 50 Z M277.02 147 A62 62 0 1 0 263.49 175.85 L245.11 160.43 A38 38 0 1 1 252.37 147 Z M172 125 V147 H254.37 V125 Z M399.84 92.16 A62 62 0 1 0 399.84 179.84 L382.87 162.87 A38 38 0 1 1 382.87 109.13 Z M390 28 H502 V50 H390 Z M434 28 H458 V196 H434 Z M600 136 A62 62 0 1 1 476 136 A62 62 0 1 1 600 136 Z M576 136 A38 38 0 1 0 500 136 A38 38 0 1 0 576 136 Z M740 136 A62 62 0 1 1 616 136 A62 62 0 1 1 740 136 Z M716 136 A38 38 0 1 0 640 136 A38 38 0 1 0 716 136 Z M716 76 H740 V197 H716 Z M740 196 A62 48 0 0 1 624.31 220 L645.09 208 A38 24 0 0 0 716 196 Z"></path>
		</svg>
	</a>
	<a class="docs" href={siteTitleHref}>Docs</a>
</div>

<style>
	.site-title {
		display: flex;
		align-items: center;
		gap: 0.75rem;
	}
	.logo {
		display: flex;
		align-items: center;
		color: var(--dt-logo);
	}
	.logo svg {
		flex-shrink: 0;
		width: auto;
	}
	.docs {
		display: inline-flex;
		align-items: center;
		height: 1.5rem;
		border-radius: var(--dt-radius-pill);
		padding-inline: 0.75rem;
		background-color: var(--dt-surface);
		color: var(--dt-ink);
		font-size: var(--sl-text-2xs);
		font-weight: 500;
		line-height: 1;
		text-decoration: none;
		transition: background-color var(--dt-ease);
	}
	.docs:hover {
		background-color: var(--dt-surface-strong);
	}
</style>
