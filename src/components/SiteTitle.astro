---
// The adto.app logo leads to the marketing site; the "Docs" pill beside it is the way back to
// the docs home. The logo is inline so its "Ad" follows the theme (currentColor); the symbol stays orange.
const { siteTitleHref } = Astro.locals.starlightRoute;
---

<div class="site-title">
	<a class="logo" href="https://adto.app" aria-label="AdTo">
		<svg viewBox="0 24 480 174" height="30" aria-hidden="true">
			<path fill="currentColor" d="M0 196 L78 24 L156 196 L129.65 196 L106.97 146 L49.03 146 L26.35 196 Z M78 82.11 L59 124 L97 124 Z M286 136 A62 62 0 1 1 162 136 A62 62 0 1 1 286 136 Z M262 136 A38 38 0 1 0 186 136 A38 38 0 1 0 262 136 Z M262 28 H286 V197 H262 Z"></path>
			<path fill="#ff520a" d="M339.24 45.69 A86 86 0 0 1 474.58 81.95 Z M390.77 80.86 L323.45 62.82 A86 86 0 0 0 361.13 191.47 Z M412.37 86.65 L382.73 197.26 A86 86 0 0 0 479.69 104.69 Z"></path>
		</svg>
	</a>
	<a class="docs" href={siteTitleHref}>Docs</a>
</div>

<style>
	.site-title {
		display: flex;
		align-items: center;
		gap: 0.75rem;
	}
	.logo {
		display: flex;
		align-items: center;
		color: var(--dt-logo);
	}
	.logo svg {
		flex-shrink: 0;
		width: auto;
	}
	.docs {
		display: inline-flex;
		align-items: center;
		height: 1.5rem;
		border-radius: var(--dt-radius-pill);
		padding-inline: 0.75rem;
		background-color: var(--dt-surface);
		color: var(--dt-ink);
		font-size: var(--sl-text-2xs);
		font-weight: 500;
		line-height: 1;
		text-decoration: none;
		transition: background-color var(--dt-ease);
	}
	.docs:hover {
		background-color: var(--dt-surface-strong);
	}
</style>
