---
// The dectog.com logo leads to the marketing site; the "Docs" pill beside it is the way back to
// the docs home. The wordmark is live text because an SVG shown as an image cannot load Outfit.
const { siteTitleHref } = Astro.locals.starlightRoute;
---

<div class="site-title">
	<a class="logo" href="https://dectog.com">
		<svg viewBox="0 0 32 32" width="30" height="30" aria-hidden="true">
			<rect x="2" y="2" width="28" height="28" rx="8" fill="none" stroke="currentColor" stroke-width="4"
			></rect>
			<circle cx="16" cy="16" r="4" fill="#ff520a"></circle>
		</svg>
		<span translate="no">DecTog</span>
	</a>
	<a class="docs" href={siteTitleHref}>Docs</a>
</div>

<style>
	.site-title {
		display: flex;
		align-items: center;
		gap: 0.75rem;
	}
	.logo {
		display: flex;
		align-items: center;
		gap: 0.5rem;
		color: var(--dt-logo);
		font-family: var(--dt-font-display);
		font-size: 1.3125rem;
		font-weight: 600;
		line-height: 1;
		text-decoration: none;
		white-space: nowrap;
	}
	.logo svg {
		flex-shrink: 0;
	}
	.docs {
		display: inline-flex;
		align-items: center;
		height: 1.5rem;
		border-radius: var(--dt-radius-pill);
		padding-inline: 0.75rem;
		background-color: var(--dt-surface);
		color: var(--dt-ink);
		font-size: var(--sl-text-2xs);
		font-weight: 500;
		line-height: 1;
		text-decoration: none;
		transition: background-color var(--dt-ease);
	}
	.docs:hover {
		background-color: var(--dt-surface-strong);
	}
</style>
