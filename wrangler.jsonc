// Cloudflare Worker that serves the built site (dist/) as static assets on
// docs.dectog.com. There is no worker script: the assets binding answers every
// request, including 404s, with the pages Astro built.
//
// The route below is more specific than the main DecTog worker's
// `*.dectog.com/*` route, so Cloudflare sends docs.dectog.com here and leaves
// every other host to the main worker.
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "dectog-docs",
	"compatibility_date": "2026-10-01",
	"assets": {
		"directory": "./dist",
		"not_found_handling": "404-page",
		"html_handling": "auto-trailing-slash"
	},
	"routes": [{ "pattern": "docs.dectog.com/*", "zone_name": "dectog.com" }],
	"workers_dev": false,
	"preview_urls": false
}
